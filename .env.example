# FastAPI application
APP_NAME=JS Notebook API
APP_ENV=dev
API_PREFIX=/api/v1

# Local server defaults
APP_HOST=0.0.0.0
APP_PORT=8000

# Database connection for local docker-compose.
# The current API template does not use it yet, but the value is reserved for
# future persistence layer configuration.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/notebook_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=notebook_dev

# Auth/session values used by the monorepo docker-compose setup.
# Replace these values in real environments and keep production secrets outside git.
OAUTH_NAME_APPLICATION_ID=change-me
OAUTH_NAME_SECRET_KEY=change-me
TOKEN_TTL_SECONDS=86400
SESSION_TTL_SECONDS=604800

# Backend code-execution endpoint (POST /api/v1/execute).
# Disabled by default: a debug/fallback subprocess runner, NOT a production
# sandbox (docs/execution-architecture.md §12). Enabling it runs user code in a
# plain `node` child process — only do so in a trusted/dev environment.
# Hard guard: APP_ENV=production/staging + ENABLE_EXECUTE=true refuses to start
# (no hardened runtime exists yet) — see app/core/config.py.
ENABLE_EXECUTE=false
# EXECUTE_NODE_COMMAND=node
# EXECUTE_DEFAULT_TIMEOUT_MS=5000
# EXECUTE_MAX_TIMEOUT_MS=15000
# EXECUTE_MAX_CODE_BYTES=262144  # enforced by ExecutionService (operator knob)
# EXECUTE_MAX_OUTPUT_BYTES=1048576
# EXECUTE_MAX_MEMORY_MB=128

# OTP email delivery (production-like environments only).
# Required when APP_ENV is production/prod/staging.
# EMAIL_FROM must be a verified Resend sender address — the
# noreply@example.com default is rejected by validate_auth_settings()
# in production-like environments.
RESEND_API_KEY=
EMAIL_FROM=noreply@example.com
# RESEND_REQUEST_TIMEOUT_SECONDS=10
# AI generation context persistence + roll-up (Epic 07 / #116).
# The notebook context built on the FE is stored at /notebooks/{id}/ai-context
# and rolled up to the 8 KiB / 10-item generation budget by a pluggable summary
# service (docs/ai-architecture.md §4.3).
# LLM_CONTEXT_SUMMARY_STRATEGY=compact-oldest  # roll-up strategy id:
#   compact-oldest (default) — deterministic, model-free fold of the oldest cells.
#   llm                       — summarise the folded cells with Bedrock (adds cost
#                               + latency on PUT; falls back to deterministic on
#                               any provider failure).
# The stored-history PUT body is bounded by LLM_MAX_PROMPT_BYTES. Oversized -> 422.

# ─── Cloud LLM provider (roadmap Step 8d-1) ──────────────────────────────────
# Which server-side adapter serves POST /llm/generate. Validated at startup.
#   bedrock    (default) — AWS Bedrock Converse; unchanged behaviour.
#   openrouter           — OpenAI-compatible OpenRouter; requires the key below.
# There is deliberately NO base-URL setting: the provider URL is fixed in the
# adapter. A free-form URL would be the same SSRF shape rejected for
# user-supplied endpoints, only with the operator as the actor
# (docs/specs/llm-provider-toggle-security-contract.md).
# LLM_PROVIDER=bedrock
# Server-only secret. Never sent to the browser, never logged. Startup fails if
# LLM_PROVIDER=openrouter and this is empty.
# LLM_OPENROUTER_API_KEY=
# Model slugs. `openrouter/free` picks a RANDOM free model per request, which is
# fine for the generator but weak for the guard pass — pin a concrete low-cost
# model before relying on deterministic guard behaviour.
# LLM_OPENROUTER_GUARD_MODEL_ID=openrouter/free
# LLM_OPENROUTER_GENERATOR_MODEL_ID=openrouter/free
# Optional OpenRouter attribution headers (leaderboards only).
# LLM_OPENROUTER_APP_TITLE=
# LLM_OPENROUTER_APP_REFERER=

# Developer allowlist for POST /llm/generate. EMPTY (default) = no restriction.
# When set, only these verified account emails may call the endpoint.
# This is a real server-side authorization check — unlike the UI's `llmEnabled`
# switch, which is a device-local preference a user can flip.
# Why it exists: on a shared free tier the daily request quota belongs to the
# DEPLOYMENT, not to a user. The per-user rate limit caps how fast one account
# spends the quota, not how many accounts spend it, so without an allowlist any
# signed-in user can exhaust the day for everyone.
# LLM_ALLOWED_EMAILS=dev-one@example.com,dev-two@example.com
